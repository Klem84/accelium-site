# ── Accelium site — variables d'environnement ──
# Copier en .env.local (gitignoré) et renseigner. Sur Vercel : Project Settings → Environment Variables.

# Email (Resend) — domaine accelium-conseil.fr vérifié
RESEND_API_KEY=
RESEND_FROM="Accelium Conseil <contact@accelium-conseil.fr>"
LEADS_TO_EMAIL=contact@accelium-conseil.fr

# CRM leads (Monday) — board « Leads Site internet »
MONDAY_API_TOKEN=
MONDAY_LEADS_BOARD_ID=5098269157

# Anti-spam (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Site
NEXT_PUBLIC_SITE_URL=https://www.accelium-conseil.fr
