{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- -p 3100",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 120000,
      "url": [
        "http://127.0.0.1:3100/",
        "http://127.0.0.1:3100/offres/financements-publics",
        "http://127.0.0.1:3100/secteurs/foret-bois",
        "http://127.0.0.1:3100/le-financement-public/financeurs/ademe",
        "http://127.0.0.1:3100/cas-clients",
        "http://127.0.0.1:3100/contact"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "mobile",
        "onlyCategories": ["performance", "accessibility", "seo", "best-practices"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
